# ===================================================================
# 📡 ИСТОЧНИКИ МЕТЕОДАННЫХ
# ===================================================================
# Провайдер данных: open-meteo (по умолчанию) или kyrgyzhydromet
WEATHER_PROVIDER=open-meteo

# Открытые API сервисы Open-Meteo (бесплатные, высокоточные, без ключа)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Официальный ресурс Кыргызгидромета (для интеграции / парсинга)
