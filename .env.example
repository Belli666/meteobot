# Токен вашего Telegram бота (получите у @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram ID владельца (число)
ADMIN_ID=123456789

# Путь к файлу базы данных SQLite (по умолчанию data/meteobot.sqlite)
DATABASE_PATH=./data/meteobot.sqlite

# Часовой пояс по умолчанию
DEFAULT_TIMEZONE=Europe/Moscow
