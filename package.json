{
  "name": "meteobot",
  "version": "1.0.0",
  "description": "Smart Meteorology Telegram Bot with location onboarding and weather advisories",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:view": "sqlite3 -header -column data/meteobot.sqlite \"SELECT id, first_name, username, city_name, language FROM users;\"",
    "db:clear": "sqlite3 data/meteobot.sqlite \"DELETE FROM users;\""
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.67.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.4",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}
